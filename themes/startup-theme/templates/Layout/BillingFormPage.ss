<% if $BillingForm %>
<div class="billing-form-page page-container">
    <div class="page-hero">
        <div class="hero-content">
            <h1 class="page-title">Billing Form</h1>
            <p class="page-subtitle">Submit your billing form below</p>
        </div>
    </div>

    <div class="form-container">
        $BillingForm
    </div>
</div>
<% end_if %>
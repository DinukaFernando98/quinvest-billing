<div class="login-page">
    <div class="page-hero__form">
        <div class="hero-content__form">
            <h1 class="page-title">Login</h1>
            <p class="page-subtitle">Login to access the form submission portal</p>
        </div>
    </div>

    <div class="form-container">
        $LoginForm

        <div class="form-footer" style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
            <p>Don't have an account? <a href="/sign-up" class="register-link" style="color: var(--primary-color); font-weight: 600;">Create Account</a></p>
        </div>
    </div>
</div>

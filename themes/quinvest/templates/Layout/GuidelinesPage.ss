<section class="guidelines-section">
  <div class="container">
    <div class="section-header">
      <h1 class="main-title">CEA Guidelines Overview</h1>
      <p class="subtitle">Revised Forms Pursuant to CEA Guidelines - Effective 30 June 2025</p>
    </div>

    <div class="guidelines-grid">
      <!-- CDD Guidelines Card -->
      <div class="guideline-card" data-category="cdd">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <polyline points="17 11 19 13 23 9"></polyline>
          </svg>
        </div>
        <h2 class="card-title">Customer Due Diligence (CDD)</h2>
        <p class="card-description">Comprehensive forms for individual and entity client verification</p>
        <button class="expand-btn" onclick="toggleContent('cdd')">
          <span>Explore Forms</span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        
        <div class="expanded-content" id="cdd-content">
          <div class="client-types">
            <div class="client-type-box">
              <h3>Individual Clients</h3>
              <div class="form-list">
                <div class="form-item">
                  <span class="form-badge">Form A1</span>
                  <span class="form-desc">Customer Particulars (Individual)</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form A3</span>
                  <span class="form-desc">Acting on behalf of another Individual</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form A4</span>
                  <span class="form-desc">Acting on behalf of Entity/Legal Arrangement</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form B</span>
                  <span class="form-desc">Risk Determination & Screening</span>
                </div>
              </div>
            </div>
            
            <div class="client-type-box">
              <h3>Entity/Legal Arrangement Clients</h3>
              <div class="form-list">
                <div class="form-item">
                  <span class="form-badge">Form A2</span>
                  <span class="form-desc">Customer Particulars (Entity)</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form A3</span>
                  <span class="form-desc">Acting on behalf of another Individual</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form A4</span>
                  <span class="form-desc">Acting on behalf of Entity/Legal Arrangement</span>
                </div>
                <div class="form-item">
                  <span class="form-badge">Form B</span>
                  <span class="form-desc">Risk Determination & Screening</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="additional-forms">
            <div class="info-box enhanced">
              <strong>Enhanced Due Diligence:</strong> Form C required for higher risk transactions
            </div>
            <div class="info-box ongoing">
              <strong>On-going Monitoring:</strong> Form D required for ongoing client relationships
            </div>
          </div>
        </div>
      </div>

      <!-- UCPDD Guidelines Card -->
      <div class="guideline-card" data-category="ucpdd">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h2 class="card-title">Unrepresented Counterparty (UCPDD)</h2>
        <p class="card-description">Specialized forms for unrepresented counterparty due diligence</p>
        <button class="expand-btn" onclick="toggleContent('ucpdd')">
          <span>Explore Forms</span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        
        <div class="expanded-content" id="ucpdd-content">
          <div class="client-types">
            <div class="client-type-box">
              <h3>Individual UCPs</h3>
              <div class="form-list">
                <div class="form-item">
                  <span class="form-badge ucp">Form U1</span>
                  <span class="form-desc">UCP Particulars (Individual)</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U3</span>
                  <span class="form-desc">Acting on behalf of another Individual</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U4</span>
                  <span class="form-desc">Acting on behalf of Entity/Legal Arrangement</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U5</span>
                  <span class="form-desc">Risk Determination & Screening</span>
                </div>
              </div>
            </div>
            
            <div class="client-type-box">
              <h3>Entity/Legal Arrangement UCPs</h3>
              <div class="form-list">
                <div class="form-item">
                  <span class="form-badge ucp">Form U2</span>
                  <span class="form-desc">UCP Particulars (Entity)</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U3</span>
                  <span class="form-desc">Acting on behalf of another Individual</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U4</span>
                  <span class="form-desc">Acting on behalf of Entity/Legal Arrangement</span>
                </div>
                <div class="form-item">
                  <span class="form-badge ucp">Form U5</span>
                  <span class="form-desc">Risk Determination & Screening</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="additional-forms">
            <div class="info-box enhanced">
              <strong>Enhanced Due Diligence:</strong> Form U6 required for higher risk transactions
            </div>
            <div class="info-box ongoing">
              <strong>On-going Monitoring:</strong> Form D required for ongoing client relationships
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="key-notes">
      <h3>Key Requirements</h3>
      <div class="notes-grid">
        <div class="note-item">
          <div class="note-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <p>Form B/U5 required for <strong>each person</strong> in the transaction</p>
        </div>
        <div class="note-item">
          <div class="note-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
          <p>Enhanced due diligence forms for <strong>higher risk</strong> transactions</p>
        </div>
        <div class="note-item">
          <div class="note-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </div>
          <p>Form D required for <strong>ongoing monitoring</strong> of client relationships</p>
        </div>
        <div class="note-item">
          <div class="note-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <p>All forms effective from <strong>30 June 2025</strong></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function toggleContent(category) {
  const content = document.getElementById(`${category}-content`);
  const card = document.querySelector(`[data-category="${category}"]`);
  const btn = card.querySelector('.expand-btn');
  const arrow = btn.querySelector('.arrow-icon');
  
  if (content.classList.contains('active')) {
    content.classList.remove('active');
    card.classList.remove('expanded');
    arrow.style.transform = 'rotate(0deg)';
  } else {
    // Close other expanded content
    document.querySelectorAll('.expanded-content.active').forEach(el => {
      el.classList.remove('active');
    });
    document.querySelectorAll('.guideline-card.expanded').forEach(el => {
      el.classList.remove('expanded');
    });
    document.querySelectorAll('.arrow-icon').forEach(el => {
      el.style.transform = 'rotate(0deg)';
    });
    
    content.classList.add('active');
    card.classList.add('expanded');
    arrow.style.transform = 'rotate(180deg)';
  }
}

// Intersection Observer for scroll animations
const observerOptions = {
  threshold: 0.1,
  rootMargin: '0px 0px -50px 0px'
};

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, observerOptions);

document.querySelectorAll('.guideline-card, .note-item').forEach(el => {
  observer.observe(el);
});
</script>